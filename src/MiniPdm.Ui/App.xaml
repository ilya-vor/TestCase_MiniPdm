<Application x:Class="MiniPdm.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:MiniPdm.Ui.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:ObjectStateToTextConverter x:Key="StateText" />
            <conv:ObjectTypeToTextConverter x:Key="TypeText" />
            <conv:ImportOutcomeToTextConverter x:Key="OutcomeText" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:HalfValueConverter x:Key="Half" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
