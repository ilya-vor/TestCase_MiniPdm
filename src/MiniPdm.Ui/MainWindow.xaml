<ui:FluentWindow x:Class="MiniPdm.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Мини-PDM: Состав изделия"
        Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Tabbed"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Default"
        FontWeight="DemiBold">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Мини-PDM: Состав изделия" />

        <!-- Панель действий -->
        <Border Grid.Row="1" Margin="12,4,12,8" Padding="12,10" CornerRadius="8"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" MinWidth="320" MaxWidth="520" HorizontalAlignment="Left"
                            PlaceholderText="Поиск по обозначению или наименованию"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Найти" Appearance="Primary" Margin="8,0,0,0" Command="{Binding SearchCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="Импорт папки" Margin="8,0,0,0" Command="{Binding ImportCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="Отменить импорт" Margin="8,0,0,0" Command="{Binding CancelImportCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Margin="12,0,0,6" Padding="10" VerticalAlignment="Top">
                    <DockPanel>
                        <ui:TextBlock DockPanel.Dock="Top" Text="Результаты поиска"
                                      FontTypography="BodyStrong" Margin="2,0,0,6" />
                        <ListBox ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Resources>
                                <!-- Вторичный текст: серый в обычном состоянии, цвет выделения — при выборе. -->
                                <Style x:Key="SearchItemSecondaryText" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <!-- Компактные элементы; справа оставляем место под overlay-скроллбар WPF-UI. -->
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="Margin" Value="0,0,12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Designation}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Designation, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource SearchItemSecondaryText}" />
                                        <TextBlock FontSize="11" Style="{DynamicResource SearchItemSecondaryText}">
                                            <Run Text="Состояние: " />
                                            <Run Text="{Binding CurrentState, Converter={StaticResource StateText}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </ui:Card>

                <ui:Card Grid.Row="1" Margin="12,6,0,12" Padding="10">
                    <DockPanel>
                        <ui:TextBlock DockPanel.Dock="Top" Text="Состав изделия"
                                      FontTypography="BodyStrong" Margin="2,0,0,6" />
                        <TreeView ItemsSource="{Binding TreeRoots}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.Resources>
                                <!-- Полосы прокрутки со своим местом (не overlay), чтобы горизонтальный бар не накрывал узлы. -->
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource UiScrollViewer}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollViewer">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                                            CanContentScroll="{TemplateBinding CanContentScroll}" />
                                                    <ScrollBar x:Name="PART_VerticalScrollBar"
                                                               Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                               Orientation="Vertical"
                                                               Maximum="{TemplateBinding ScrollableHeight}"
                                                               ViewportSize="{TemplateBinding ViewportHeight}"
                                                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                               Value="{TemplateBinding VerticalOffset}" />
                                                    <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                               Grid.Row="1" Grid.Column="0"
                                                               Orientation="Horizontal"
                                                               Maximum="{TemplateBinding ScrollableWidth}"
                                                               ViewportSize="{TemplateBinding ViewportWidth}"
                                                               Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                               Value="{TemplateBinding HorizontalOffset}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="4,1" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </ui:Card>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{ui:ThemeResource CardStrokeColorDefaultBrush}" />

            <TabControl Grid.Column="2" Margin="0,0,12,0" Padding="0,8,0,0">
                <TabItem Header="Карточка объекта">
                    <Grid Margin="4,8,4,4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Details, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                            <ui:SymbolIcon Symbol="Cube24" FontSize="48"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            <TextBlock Text="Выберите объект в результатах поиска или в дереве состава"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding Details, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <ui:TextBlock Text="{Binding Details.Object.Name}" FontTypography="Title" />
                                <TextBlock Text="{Binding Details.Object.Designation}"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0" />

                                <Border Margin="0,12,0,0" Padding="14" CornerRadius="8"
                                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип:" FontWeight="SemiBold" Margin="0,3,12,3" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,3"
                                                   Text="{Binding Details.Object.Type, Converter={StaticResource TypeText}}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Текущая версия:" FontWeight="SemiBold" Margin="0,3,12,3" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details.CurrentVersion.VersionNo}" Margin="0,3" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Состояние:" FontWeight="SemiBold" Margin="0,3,12,3" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3"
                                                   Text="{Binding Details.CurrentVersion.State, Converter={StaticResource StateText}}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Материал:" FontWeight="SemiBold" Margin="0,3,12,3" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Details.CurrentVersion.Material}" Margin="0,3" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Масса за единицу, кг:" FontWeight="SemiBold" Margin="0,3,12,3" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Details.CurrentVersion.MassKg}" Margin="0,3" />
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ui:Button Content="Утвердить" Appearance="Primary" Margin="0,0,8,0"
                                               Command="{Binding ApproveCommand}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Checkmark24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="Аннулировать" Appearance="Danger"
                                               Command="{Binding CancelStateCommand}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="Рассчитать массу" Margin="24,0,8,0"
                                               Command="{Binding CalculateMassCommand}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Calculator24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="Сводная спецификация"
                                               Command="{Binding SpecificationCommand}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="DocumentTable24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>

                                <TextBlock Text="{Binding MassText}" Margin="0,12,0,0" TextWrapping="Wrap"
                                           FontWeight="SemiBold" />

                                <ui:TextBlock Text="Версии" FontTypography="BodyStrong" Margin="0,18,0,6" />
                                <ui:DataGrid ItemsSource="{Binding Versions}" AutoGenerateColumns="False"
                                             IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                             MaxHeight="240">
                                    <ui:DataGrid.Columns>
                                        <DataGridTextColumn Header="Версия" Binding="{Binding VersionNo}" Width="70" />
                                        <DataGridTextColumn Header="Состояние" Width="140"
                                                            Binding="{Binding State, Converter={StaticResource StateText}}" />
                                        <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="*" />
                                        <DataGridTextColumn Header="Масса, кг" Binding="{Binding MassKg}" Width="100" />
                                        <DataGridTextColumn Header="Создана" Width="150"
                                                            Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" />
                                    </ui:DataGrid.Columns>
                                </ui:DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Сводная спецификация">
                    <DockPanel Margin="4,8,4,4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="Построить для выбранного объекта"
                                       Command="{Binding SpecificationCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Экспорт в CSV…" Margin="8,0,0,0"
                                       Command="{Binding ExportSpecificationCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Save24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <ui:DataGrid ItemsSource="{Binding SpecificationRows}" AutoGenerateColumns="False"
                                     IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="180" />
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Тип" Width="160"
                                                    Binding="{Binding Type, Converter={StaticResource TypeText}}" />
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding TotalQuantity}" Width="70" />
                                <DataGridTextColumn Header="Масса за шт., кг" Binding="{Binding UnitMassKg}" Width="140" />
                                <DataGridTextColumn Header="Масса всего, кг" Binding="{Binding TotalMassKg}" Width="140" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Отчёт импорта">
                    <DockPanel Margin="4,8,4,4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ReportSummary}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ui:Button Content="Очистить" Margin="12,0,0,0" Command="{Binding ClearReportCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <ui:DataGrid ItemsSource="{Binding ImportEntries}" AutoGenerateColumns="False"
                                     IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn Header="Файл" Binding="{Binding File}" Width="280" />
                                <DataGridTextColumn Header="Результат" Width="150"
                                                    Binding="{Binding Outcome, Converter={StaticResource OutcomeText}}" />
                                <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Строка состояния -->
        <Border Grid.Row="3" Padding="14,7" BorderThickness="0,1,0,0"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ImportProgressText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ProgressBar Width="220" Height="6" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                 Value="{Binding ImportProgress, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
