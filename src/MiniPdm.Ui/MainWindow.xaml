<Window x:Class="MiniPdm.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Мини-PDM: Состав изделия"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="2,0,4,0" />
                <TextBox Width="260" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Найти" Command="{Binding SearchCommand}" Margin="4,0,0,0" />
                <Separator />
                <Button Content="Импорт папки…" Command="{Binding ImportCommand}" />
                <Button Content="Отменить импорт" Command="{Binding CancelImportCommand}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ImportProgressText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ProgressBar Width="220" Height="14" Minimum="0" Maximum="100"
                                 Value="{Binding ImportProgress, Mode=OneWay}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="240" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Результаты поиска">
                    <ListBox ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Designation}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="#555" />
                                    <TextBlock FontSize="10" Foreground="#888">
                                        <Run Text="Состояние: " />
                                        <Run Text="{Binding CurrentState, Converter={StaticResource StateText}}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Состав изделия">
                    <TreeView ItemsSource="{Binding TreeRoots}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDD" />

            <TabControl Grid.Column="2" Margin="4">
                <TabItem Header="Карточка объекта">
                    <Grid Margin="12">
                        <TextBlock Text="Выберите объект в результатах поиска или в дереве состава."
                                   Foreground="#888"
                                   Visibility="{Binding Details, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding Details, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Details.Object.Name}" FontSize="20" FontWeight="Bold" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Обозначение:" FontWeight="SemiBold" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Details.Object.Designation}" Margin="0,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип:" FontWeight="SemiBold" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2"
                                               Text="{Binding Details.Object.Type, Converter={StaticResource TypeText}}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Текущая версия:" FontWeight="SemiBold" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.CurrentVersion.VersionNo}" Margin="0,2" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Состояние:" FontWeight="SemiBold" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2"
                                               Text="{Binding Details.CurrentVersion.State, Converter={StaticResource StateText}}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Материал:" FontWeight="SemiBold" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Details.CurrentVersion.Material}" Margin="0,2" />
                                </Grid>

                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="Масса за единицу, кг: " FontWeight="SemiBold" />
                                    <Run Text="{Binding Details.CurrentVersion.MassKg}" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Утвердить" Command="{Binding ApproveCommand}" Margin="0,0,8,0" Padding="10,4" />
                                    <Button Content="Аннулировать" Command="{Binding CancelStateCommand}" Padding="10,4" />
                                    <Button Content="Рассчитать массу" Command="{Binding CalculateMassCommand}" Margin="24,0,8,0" Padding="10,4" />
                                    <Button Content="Сводная спецификация" Command="{Binding SpecificationCommand}" Padding="10,4" />
                                </StackPanel>

                                <TextBlock Text="{Binding MassText}" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

                                <TextBlock Text="Версии:" Margin="0,16,0,4" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding Versions}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Версия" Binding="{Binding VersionNo}" Width="70" />
                                        <DataGridTextColumn Header="Состояние" Width="130"
                                                            Binding="{Binding State, Converter={StaticResource StateText}}" />
                                        <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="*" />
                                        <DataGridTextColumn Header="Масса, кг" Binding="{Binding MassKg}" Width="90" />
                                        <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Сводная спецификация">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Построить для выбранного объекта" Command="{Binding SpecificationCommand}" Padding="8,4" />
                            <Button Content="Экспорт в CSV…" Command="{Binding ExportSpecificationCommand}" Margin="8,0,0,0" Padding="8,4" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding SpecificationRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="180" />
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Тип" Width="150"
                                                    Binding="{Binding Type, Converter={StaticResource TypeText}}" />
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding TotalQuantity}" Width="70" />
                                <DataGridTextColumn Header="Масса за шт., кг" Binding="{Binding UnitMassKg}" Width="130" />
                                <DataGridTextColumn Header="Масса всего, кг" Binding="{Binding TotalMassKg}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Отчёт импорта">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ReportSummary}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Content="Очистить" Command="{Binding ClearReportCommand}" Margin="12,0,0,0" Padding="8,4" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ImportEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Файл" Binding="{Binding File}" Width="260" />
                                <DataGridTextColumn Header="Результат" Width="140"
                                                    Binding="{Binding Outcome, Converter={StaticResource OutcomeText}}" />
                                <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
